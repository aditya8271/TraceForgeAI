# Local defaults. For Cloud Run, supply secrets through Secret Manager-backed
# environment variables rather than copying a .env file into the image.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TRACEFORGE_CORS_ORIGINS=http://localhost:3000
TRACEFORGE_NPCI_AUTO_REFRESH=true
TRACEFORGE_MAX_REQUEST_BYTES=2200000
TRACEFORGE_GEMINI_MAX_REQUESTS_PER_MINUTE=10
TRACEFORGE_GEMINI_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
# Leave DATABASE_URL blank for local SQLite; production must use PostgreSQL.
DATABASE_URL=
